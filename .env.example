# AegisGuard / Strix configuration template.
# The application reads real environment variables (and ~/.strix/cli-config.json),
# NOT this file. Export these in your shell, e.g.:  set -a; source .env; set +a
# Never commit a populated copy of this file.

# --- Required: LLM provider -------------------------------------------------
STRIX_LLM=openrouter/z-ai/glm-5.3
LLM_API_KEY=replace-with-your-provider-key
# LLM_API_BASE=http://localhost:11434        # optional: local / custom endpoint

# --- Privacy / network -------------------------------------------------------
# Anonymous telemetry to upstream PostHog/Scarf is ON by default. Disable it:
STRIX_TELEMETRY=0
# Stop version checks against the upstream Strix GitHub/PyPI:
STRIX_NO_UPDATE_CHECK=1

# --- Optional -----------------------------------------------------------------
# STRIX_IMAGE=ghcr.io/usestrix/strix-sandbox:1.4.1
# PERPLEXITY_API_KEY=
# EXA_API_KEY=
